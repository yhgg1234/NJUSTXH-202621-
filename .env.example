# XH-202621 环境变量配置模板
# 复制此文件为 .env 并填入实际值：cp .env.example .env

# ==============================
# 基础配置
# ==============================
DEBUG=true

# ==============================
# Neo4j 图数据库
# ==============================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123
NEO4J_DATABASE=neo4j

# ==============================
# MySQL 关系数据库
# ==============================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=job_graph

# ==============================
# MongoDB 文档数据库
# ==============================
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=job_data

# ==============================
# 大模型服务
# ==============================
# Spark Lite HTTP 接口；LLM_API_KEY 填科大讯飞控制台 HTTP 服务的 APIPassword
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# ==============================
# 服务端口
# ==============================
API_PORT=8000

# ==============================
# 子任务 2.4 新岗位发现
# ==============================
# 可填写一个 normalized_records.jsonl/json 文件，或包含这些文件的目录。
DISCOVERY_NORMALIZED_PATH=data/processed/normalized
# 候选、人工审核和岗位能力变更日志的本地持久化文件。
DISCOVERY_STATE_PATH=data/processed/discovery/state.json
# 每次发现执行后导出的数据质量报告，用于验收审计。
DISCOVERY_QUALITY_REPORT_PATH=data/processed/discovery/quality_report.json

